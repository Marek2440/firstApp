# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=3000

# Notion: notion.so/profile/integrations -> nowa integracja (Internal), skopiuj token.
# Potem na stronie Tasks Tracker: ... -> Connections -> dodaj tę integrację.
NOTION_TOKEN=
# Opcjonalnie: inna baza zadań (ID data source)
NOTION_TASKS_DS=
